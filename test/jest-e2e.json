{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^generated/prisma/client$": "<rootDir>/mocks/prisma-client.mock.ts",
    "^generated/prisma/enums$": "<rootDir>/../generated/prisma/enums.ts"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
